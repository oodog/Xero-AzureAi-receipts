# Flask
FLASK_SECRET_KEY=change-me
SESSION_TYPE=filesystem

# Azure Storage (Blob)
AZURE_STORAGE_ACCOUNT_NAME=yourstorage
AZURE_STORAGE_ACCOUNT_KEY=yourkey
AZURE_STORAGE_BLOB_ENDPOINT=https://yourstorage.blob.core.windows.net
RECEIPTS_CONTAINER_UPLOADS=uploads
RECEIPTS_CONTAINER_PROCESSING=processing
RECEIPTS_CONTAINER_JSON=json
RECEIPTS_CONTAINER_COMPLETE=complete

# Azure Document Intelligence (v4 GA)
AZURE_DI_ENDPOINT=https://your-di-resource.cognitiveservices.azure.com/
AZURE_DI_KEY=your-di-key

# Cosmos DB (NoSQL)
COSMOS_URI=https://your-cosmos.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key
COSMOS_DB=xeroflow
COSMOS_CONTAINER_RECEIPTS=receipt_features
COSMOS_CONTAINER_TOKENS=tokens

# Azure AI Search (vector)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-search-admin-key
AZURE_SEARCH_INDEX=receipts

# Embeddings (Azure OpenAI preferred)
# Option A: Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-aoai.openai.azure.com/
AZURE_OPENAI_API_KEY=your-aoai-key
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Option B: OpenAI (if you don’t use Azure). Leave Azure vars empty and set these:
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Xero OAuth (existing in your app)
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_REDIRECT_URI=https://yourapp.com/callback/xero
XERO_SCOPES=offline_access accounting.transactions accounting.contacts accounting.settings
# You must store per-tenant tokens; see services/xero_client.py notes

# AU specifics
DEFAULT_TAX_TYPE_AU=GSTONIMPORTS
DEFAULT_TAX_TYPE_AU_EXPENSE=INPUT
# Optional: override defaults with org’s preferred tax type names as returned by Xero


# --- Email via Microsoft Graph ---
EMAIL_PROVIDER=graph
EMAIL_AAD_TENANT_ID=
EMAIL_AAD_CLIENT_ID=
EMAIL_AAD_CLIENT_SECRET=
EMAIL_MAILBOX=accounts@yourdomain.com
EMAIL_FOLDER=Receipts
EMAIL_WEBHOOK_BASEURL=https://yourapp.yourdomain.com
EMAIL_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,heic
EMAIL_MAX_MB=15
# Optional: default tenant mapping (used if you don’t persist per-subscription)
EMAIL_DEFAULT_TENANT_ID=

